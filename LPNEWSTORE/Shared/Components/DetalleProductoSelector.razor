@using Entities
@using LPNEWSTORE.Shared.Modals
@using MudBlazor
@inject IDialogService DialogService

<MudPaper Class="p-2 mb-4" Outlined="true">
    <div class="groupbox">
        <div class="groupbox-title">Información Producto</div>

        <div class="groupbox-content">
            <MudGrid GutterSize="2" AlignItems="Center">

                <!-- Código (2) -->
                <MudItem xs="12" md="2">
                    <MudText Typo="Typo.caption">Código Producto:</MudText>
                    <MudTextField @bind-Value="_codigo"
                                  ReadOnly="true"
                                  Dense="true" />
                </MudItem>

                <!-- Producto (3) -->
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption">Producto:</MudText>
                    <MudTextField @bind-Value="_nombre"
                                  ReadOnly="true"
                                  Dense="true"
                                  Placeholder="Doble clic o lupa para buscar…"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  AdornmentColor="Color.Primary"
                                  OnAdornmentClick="AbrirMDProducto"
                                  @ondblclick="AbrirMDProducto" />
                </MudItem>

                <!-- Precio (2) -->
                <MudItem xs="6" md="2">
                    <MudText Typo="Typo.caption">Precio:</MudText>
                    <MudNumericField T="decimal"
                                     @bind-Value="_precio"
                                     Dense="true"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$" />
                </MudItem>

                <!-- Cotización U$S (2) -->
                <MudItem xs="6" md="2">
                    <MudText Typo="Typo.caption">Cotización U$S:</MudText>

                    @if (_cotizacionCargada)
                    {
                        <MudNumericField T="decimal"
                                         @key="_campoCotizacionKey"
                                         @bind-Value="_cotizacionUsd"
                                         Dense="true"
                                         Adornment="Adornment.Start"
                                         AdornmentText="U$S" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">Cargando...</MudText>
                    }
                </MudItem>

                <!-- Stock (1) -->
                <MudItem xs="6" md="1">
                    <MudText Typo="Typo.caption">Stock:</MudText>
                    <MudNumericField T="int"
                                     @bind-Value="_stock"
                                     ReadOnly="true"
                                     Dense="true" />
                </MudItem>

                <!-- Cantidad (1) -->
                <MudItem xs="6" md="1" Class="mb-3">
                    <MudText Typo="Typo.caption">Cantidad:</MudText>
                    <MudNumericField T="int"
                                     @bind-Value="_cantidad"
                                     Min="1"
                                     Dense="true" />
                </MudItem>

                <!-- Botón Agregar (1) -->
                <MudItem xs="12" md="1" Class="d-flex align-end justify-end mb-3">
                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AgregarAsync"
                               FullWidth="true">
                        Agregar
                    </MudButton>
                </MudItem>

            </MudGrid>
        </div>
    </div>
</MudPaper>


<!-- Grilla de detalle -->
<MudTable Items="Items"
          Dense="true"
          Hover="true"
          Elevation="2"
          Bordered="true">
    <HeaderContent>
        <MudTh>PRODUCTO</MudTh>
        <MudTh>MARCA</MudTh>
        <MudTh>MODELO</MudTh>
        <MudTh>COLOR</MudTh>
        <MudTh>S/N</MudTh>
        <MudTh class="text-end">PRECIO</MudTh>
        <MudTh class="text-end">PRECIO LISTA</MudTh>
        <MudTh class="text-end">CANTIDAD</MudTh>
        <MudTh class="text-end">COTIZACIÓN</MudTh>
        <MudTh class="text-end">SUB TOTAL</MudTh>
        <MudTh>SERIALIZABLE</MudTh>
        <MudTh>DOLARIZADO?</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="PRODUCTO">@context.Nombre</MudTd>
        <MudTd DataLabel="MARCA">@context.Marca</MudTd>
        <MudTd DataLabel="MODELO">@context.Modelo</MudTd>
        <MudTd DataLabel="COLOR">@context.Color</MudTd>
        <MudTd DataLabel="S/N">@context.SerialNumber</MudTd>
        <MudTd DataLabel="PRECIO" Class="text-end">@context.Precio.ToString("N2")</MudTd>
        <MudTd DataLabel="PRECIO LISTA" Class="text-end">@context.PrecioLista.ToString("N2")</MudTd>
        <MudTd DataLabel="CANTIDAD" Class="text-end">@context.Cantidad</MudTd>
        <MudTd DataLabel="COTIZACIÓN" Class="text-end">@context.Cotizacion.ToString("N2")</MudTd>
        <MudTd DataLabel="SUB TOTAL" Class="text-end">@context.SubTotalPesos.ToString("N2")</MudTd>
        <MudTd DataLabel="SERIALIZABLE">@((context.EsSerializable) ? "Sí" : "No")</MudTd>
        <MudTd DataLabel="DOLARIZADO?">@((context.Dolarizado) ? "Sí" : "No")</MudTd>
    </RowTemplate>
</MudTable>

@code
{

    [Inject] ISnackbar? Snackbar { get; set; }

    // ********** Parámetros públicos **********

    /// <summary>
    /// Detalle de productos (se puede usar bind-Items).
    /// </summary>
    [Parameter] public List<DetalleProductoItem> Items { get; set; } = new();
    [Parameter] public EventCallback<List<DetalleProductoItem>> ItemsChanged { get; set; }

    /// <summary>
    /// Cotización inicial a usar al cargar el componente
    /// (pasale la cotización activa desde la página padre).
    /// </summary>
    [Parameter] public decimal CotizacionInicialUsd { get; set; }

    // Ej: id sucursal, si lo necesitás para MDProducto/MDSerial
    [Parameter] public int? IdSucursal { get; set; }

    // ********** Estado interno de la cabecera **********

    private int _idProducto;
    private int _idProductoDetalle;
    private string _codigo = string.Empty;
    private string _nombre = string.Empty;
    private string _marca = string.Empty;
    private string _modelo = string.Empty;
    private string _color = string.Empty;
    private bool _esSerializable;
    private bool _dolarizado;
    private int _stock;
    private decimal _precioCompra;
    private decimal _precio;
    private decimal _precioLista;       
    private int _cantidad = 1;
    private string? _serialNumber;

    private decimal _cotizacionUsd;
    private decimal _ultimaCotizacionInicial;
    private bool _cotizacionCargada;
    private int _campoCotizacionKey;

    protected override void OnParametersSet()
    {
        if (CotizacionInicialUsd > 0 && CotizacionInicialUsd != _ultimaCotizacionInicial)
        {
            _ultimaCotizacionInicial = CotizacionInicialUsd;
            _cotizacionUsd = CotizacionInicialUsd;
            _cotizacionCargada = true;
            _campoCotizacionKey++;
        }
    }

    // ----------- Buscar producto (MDProducto) -------------

    private async Task AbrirMDProducto()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large
        };

        var parameters = new DialogParameters
        {
            // Ejemplo, por si MDProducto necesita la sucursal:
            //{ "IdSucursal", IdSucursal }
        };

        // Cambia MDProducto por el nombre real de tu modal
        var dialog = DialogService.Show<MDProducto>("Seleccionar producto", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled) return;

        // Acá casteás al tipo que devuelve tu MDProducto
        // Ej: var prod = (ProductoNegocioDto)result.Data;
        var prod = (Producto)result.Data; // <-- renombralo a tu tipo

        CargarProducto(prod);
    }

    private void CargarProducto(Producto prod)
    {
        _idProducto = prod.IdProducto;

        _codigo = prod.Codigo;
        _nombre = prod.Nombre;
        _marca = string.Empty;
        _modelo = string.Empty;
        _color = string.Empty;
        _stock = prod.Stock;
        _precio = prod.PrecioVenta;
        _precioLista = prod.PrecioLista;
        _esSerializable = prod.ProdSerializable;
        _dolarizado = prod.ProductoDolar;
        _cantidad = 1;
        _serialNumber = string.Empty;
        _precioCompra = prod.PrecioCompra;



        StateHasChanged();
    }

    // ----------- Agregar a la grilla ----------------------

    private async Task AgregarAsync()
    {
        if (_idProducto == 0)
        {
            Snackbar?.Add("Primero seleccioná un producto.", Severity.Warning);
            return;
        }

        if (_cantidad <= 0)
        {
            Snackbar?.Add("La cantidad debe ser mayor a 0.", Severity.Warning);
            return;
        }

        if (_dolarizado && _cotizacionUsd <= 0)
        {
            Snackbar?.Add("La cotización debe ser mayor a 0.", Severity.Warning);
            return;
        }

        if (_esSerializable)
        {
            await AbrirMDSerialNumberAsync();
        }
        else
        {
            await AgregarLineaAsync(_serialNumber);
        }

        LimpiarCabecera();
        StateHasChanged();
    }


    private void LimpiarCabecera()
    {
        _idProducto = 0;
        _idProductoDetalle = 0;
        _codigo = string.Empty;
        _nombre = string.Empty;
        _marca = string.Empty;
        _modelo = string.Empty;
        _color = string.Empty;
        _stock = 0;
        _precio = 0;
        _precioLista = 0;
        _esSerializable = false;
        _dolarizado = false;
        _serialNumber = null;
        _precioCompra = 0;
        // Cantidad vuelve a 1
        _cantidad = 1;

        // NO tocamos _cotizacionUsd para que quede igual
    }

    /// <summary>
    /// Abre el modal de selección de serial numbers cuando el producto es serializable.
    /// </summary>
    private async Task AbrirMDSerialNumberAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium
        };

        var parameters = new DialogParameters
        {
            { "IdProducto", _idProducto },

            { "IdNegocio", IdSucursal }
        };

        // Cambia MDSeleccionSerial por el nombre real de tu modal de SN
        var dialog = DialogService.Show<MDSeleccionSN>("Seleccionar número de serie", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ProductoDetalle productoDetalle)
        {
            _idProductoDetalle = productoDetalle.IdProductoDetalle;
            _marca = productoDetalle.Marca;
            _modelo = productoDetalle.Modelo;
            _color = productoDetalle.Color;
            _serialNumber = productoDetalle.NumeroSerie;
        } else
        {
            return;
        }

              

        

        await AgregarLineaAsync(_serialNumber);
    }

    private async Task AgregarLineaAsync(string? serial)
    {
        // 1) Si el producto NO es serializable, intento acumular en una fila existente
        if (!_esSerializable)
        {
            // Buscamos una fila del mismo producto no serializable
            var existente = Items
                .FirstOrDefault(x => x.IdProducto == _idProducto && !x.EsSerializable);

            if (existente is not null)
            {
                // Sumamos la cantidad
                existente.Cantidad += _cantidad;

                // Opcional: actualizamos precio / cotización por si cambiaron
                existente.Precio = _precio;
                existente.PrecioLista = _precioLista;
                existente.Cotizacion = CotizacionInicialUsd;

                if (ItemsChanged.HasDelegate)
                    await ItemsChanged.InvokeAsync(Items);

                // Reseteo de cabecera
                _cantidad = 1;
                _serialNumber = null;

                StateHasChanged();
                return; // 👈 IMPORTANTE: no agregamos nueva fila
            }
        }

        // 2) Si es serializable o no había fila previa, agregamos una nueva línea
        var item = new DetalleProductoItem
        {
            IdProducto = _idProducto,
            IdProductoDetalle = _idProductoDetalle,
            Codigo = _codigo,
            Nombre = _nombre,
            Marca = _marca,
            Modelo = _modelo,
            Color = _color,
            SerialNumber = serial,
            Precio = _precio,
            PrecioLista = _precioLista,
            Cantidad = _esSerializable? 1: _cantidad,
            Cotizacion = CotizacionInicialUsd,
            EsSerializable = _esSerializable,
            Dolarizado = _dolarizado,
            PrecioCompra = _precioCompra
            
        };

        Items.Add(item);

        if (ItemsChanged.HasDelegate)
            await ItemsChanged.InvokeAsync(Items);

        // Dejo el producto seleccionado pero reseteo cantidad y SN
        _cantidad = 1;
        _serialNumber = null;

        StateHasChanged();
    }


    // ************* Clases auxiliares ******************

    public class DetalleProductoItem
    {
        public int IdProducto { get; set; }
        public int IdEmpresa { get; set; }
        public int IdProductoDetalle { get; set; }
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Marca { get; set; } = string.Empty;
        public string Modelo { get; set; } = string.Empty;
        public string Color { get; set; } = string.Empty;
        public string? SerialNumber { get; set; }
        
        public decimal Precio { get; set; }
        public decimal PrecioLista { get; set; }
        public decimal PrecioCompra { get; set; }
        public int Cantidad { get; set; }
        public decimal Cotizacion { get; set; }
        public bool EsSerializable { get; set; }
        public bool Dolarizado { get; set; }

        // Si está dolarizado se multiplica por la cotización para el subtotal en pesos
        public decimal SubTotalPesos => Dolarizado
            ? PrecioLista * Cantidad * Cotizacion
            : PrecioLista * Cantidad;
    }

    // DTO que devuelve MDProducto: cambiá nombres según tu modelo real
    public class ProductoSeleccionadoDto
    {
        public int IdProducto { get; set; }
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Marca { get; set; } = string.Empty;
        public string Modelo { get; set; } = string.Empty;
        public string Color { get; set; } = string.Empty;
        public int StockActual { get; set; }
        public decimal PrecioVenta { get; set; }
        public decimal PrecioLista { get; set; }
        public bool EsSerializable { get; set; }
        public bool Dolarizado { get; set; }
    }
}
<style>
    .groupbox {
        position: relative;
       
        border-radius: 4px;
        padding-top: 12px;
    }

    .groupbox-title {
        position: absolute;
        top: -10px;
        left: 12px;
        background-color: var(--mud-palette-surface);
        padding: 0 6px;
        font-weight: 600;
        color: var(--mud-palette-primary);
        font-size: 0.9rem;
    }

    .groupbox-content {
        padding: 6px 8px 4px 8px;
    }
</style>
