@typeparam TProducto
@using System.ComponentModel.DataAnnotations
@using Entities
@using LPNEWSTORE.Shared.Modals
@using MudBlazor
@using Services
@using static LPNEWSTORE.Shared.Modals.MDRecargoDescuento
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CotizacionService CotizacionService
<div class="mt-4 pago-wrapper">
<MudGrid >

    <!-- COLUMNA 1: AGREGAR PAGO -->
    <MudItem xs="12" md="4">
        <MudPaper Class="p-3 px-2 pago-paper" Elevation="1">
            <MudText Typo="Typo.subtitle1" Color="Color.Success">Agregar Pago</MudText>

            <MudGrid Class="mt-2" GutterSize="2">

                <!-- Forma de pago + Pago parcial -->
                <MudItem xs="12" sm="8">
                    <MudSelect T="int"
                               Label="Forma de Pago"
                               @bind-Value="_formaPagoId">
                        @foreach (var fp in FormasPago)
                        {
                            <MudSelectItem Value="@fp.IdFormaPago">@fp.Descripcion</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="6" sm="4" Class="d-flex align-center justify-end">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               OnClick="OnPagoParcialClick">
                        Pago Parcial
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Class="ml-1" />
                    </MudButton>
                </MudItem>

                <!-- Importe + boton + contador -->
                <MudItem xs="12" sm="8">
                    <MudNumericField T="decimal"
                                     Label="Importe"
                                     @bind-Value="_importe"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     DecimalPlaces="2" />
                </MudItem>

                <MudItem xs="6" sm="2" Class="d-flex align-center">
                    <MudButton Color="Color.Success"
                               Size="Size.Small"
                               Variant="Variant.Filled"
                               FullWidth="true"
                               OnClick="AgregarPago">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                    </MudButton>
                </MudItem>

                <MudItem xs="6" sm="2" Class="d-flex align-center justify-center">
                    <MudText Typo="Typo.subtitle1">@_pagos.Count</MudText>
                </MudItem>

                <!-- Aplicar descuento / recargo -->
                <MudItem xs="12" Class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="OnDescuentoRecargoClick">
                            Agregar descuento / recargo
                            <MudIcon Icon="@Icons.Material.Filled.Percent" Class="ml-1" />
                        </MudButton>
                    </MudStack>
                </MudItem>

            </MudGrid>
        </MudPaper>
    </MudItem>

    <!-- COLUMNA 2: GRILLA FORMAS DE PAGO -->
    <MudItem xs="12" md="4">
        <MudPaper Class="p-3 px-2 pago-paper" Elevation="1">
            <MudText Typo="Typo.subtitle1" Color="Color.Success">Formas de Pago</MudText>

            <MudTable Items="@_pagos" Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-2 mb-3">
                <HeaderContent>
                    <MudTh>FORMA DE PAGO</MudTh>
                    <MudTh class="text-right">IMPORTE</MudTh>
                    <MudTh style="width:40px;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.FormaPagoNombre</MudTd>
                    <MudTd DataLabel="Importe" Class="text-right">
                        @context.SimboloMoneda @context.Importe.ToString("N2")
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => EliminarPago(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <!-- COLUMNA 3: DETALLE PAGO -->
    <MudItem xs="12" md="4">
        <MudPaper Class="p-3 px-2 pago-paper" Elevation="1">
            <MudText Typo="Typo.subtitle1" Color="Color.Success">Detalle Pago</MudText>

            <MudGrid Class="mt-2" GutterSize="2">

                <MudItem xs="6">
                    <MudNumericField T="decimal"
                                     Label="Total U$S"
                                     Value="@TotalUsd"
                                     ReadOnly="true"
                                     
                                     DecimalPlaces="2" />
                </MudItem>

                <MudItem xs="6">
                    <MudNumericField T="decimal"
                                     Label="Restan U$S"
                                     Value="@RestanUsd"
                                     ReadOnly="true"
                                     DecimalPlaces="2" />
                </MudItem>

                <MudItem xs="6">
                    <MudNumericField T="decimal"
                                     Label="Total $"
                                     Value="@TotalVenta"
                                     ReadOnly="true"
                                     DecimalPlaces="2" />
                </MudItem>

                <MudItem xs="6">
                    <MudNumericField T="decimal"
                                     Label="Restan $"
                                     Value="@RestanPesos"
                                     ReadOnly="true"
                                     DecimalPlaces="2" 
                                     />
                </MudItem>

                <MudItem xs="12" Class="mb-3">
                    <MudNumericField T="decimal"
                                     Label="Cambio"
                                     Value="@Cambio"
                                     ReadOnly="true"
                                     DecimalPlaces="2" />
                </MudItem>

            </MudGrid>
        </MudPaper>
    </MudItem>

</MudGrid>
    
</div>


@code {

    // ---------- Parámetros públicos ----------

    /// <summary>Lista de formas de pago (llenada desde la página).</summary>
    [Parameter] public List<FormaPago> FormasPago { get; set; } = new();

    /// <summary>Productos a los que se les aplican los pagos.</summary>
    [Parameter] public IEnumerable<TProducto> Productos { get; set; } = Enumerable.Empty<TProducto>();

    /// <summary>Función que indica cómo obtener el PrecioLista de cada producto.</summary>
    [Parameter] public Func<TProducto, decimal> GetPrecioLista { get; set; } = default!;

    /// <summary>Devuelve la lista de pagos al padre cada vez que cambia.</summary>
    [Parameter] public EventCallback<List<PagoDetalle>> PagosChanged { get; set; }

    /// <summary>Callback para abrir el modal de pagos parciales.</summary>
    [Parameter] public EventCallback OnPagoParcial { get; set; }





    // ---------- Estado interno ----------
    private int _formaPagoId;
    private decimal _importe;
    private decimal _cotizacionActual;
    private bool _esDescuento;
    private bool _esRecargo;
    private bool _esUsd;          // lo dejé por si lo usás después, pero no interviene en los totales
    private decimal _porcentaje;
    private decimal _montoDescRec;

    

    private readonly List<PagoDetalle> _pagos = new();
    public IReadOnlyList<PagoDetalle> Pagos => _pagos;

    // ---------- Ciclo de vida ----------
    protected override async Task OnInitializedAsync()
    {
        var cot = await CotizacionService.CotizacionActiva();
        _cotizacionActual = cot?.Importe ?? 1m;

        if (_cotizacionActual <= 0)
            _cotizacionActual = 1m;
    }

    public async Task LimpiarAsync()
    {
        _pagos.Clear();
        // avisás al padre que se limpiaron los pagos (para que recalcule totales, etc.)
        await PagosChanged.InvokeAsync(_pagos);
        StateHasChanged();
    }


   

    private async Task OnDescuentoRecargoClick()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        // Abrimos el modal MDRecargoDescuento
        var dialog = DialogService.Show<MDRecargoDescuento>(
            "Agregar descuento / recargo",
            options
        );

        var result = await dialog.Result;

        if (result.Canceled || result.Data is not AjusteLinea ajuste)
            return;

        // ----- Flags internos -----
        _esDescuento = ajuste.Operacion == "DESCUENTO";
        _esRecargo = ajuste.Operacion == "RECARGO";

        if (ajuste.Tipo == "PORCENTAJE")
        {
            _porcentaje = ajuste.Valor; // 0 a 100
            _montoDescRec = 0;
        }
        else // MONTO_FIJO
        {
            _montoDescRec = ajuste.Valor;
            _porcentaje = 0;
        }

        // ----- Texto para la grilla -----
        var textoOperacion = _esDescuento ? "Descuento" : "Recargo";
        string textoTipo = ajuste.Tipo == "MONTO_FIJO"
            ? "Monto fijo"
            : $"Porcentual del {ajuste.Valor:N2} %";

        var nombreFormaPago = $"{textoOperacion} - {textoTipo}";

        // ----- Calcular importe del ajuste en pesos -----
        decimal totalBase = TotalVenta;

        // 1) calculamos el monto base (siempre positivo)
        decimal importeAjuste = CalcularImporteDescuentoRecargo(totalBase, ajuste);

        // 2) aplicamos el signo según si es DESCUENTO o RECARGO
        //    DESCUENTO  -> +monto  (resta del saldo)
        //    RECARGO    -> -monto  (aumenta el saldo)
        importeAjuste = _esDescuento
            ? importeAjuste
            : -importeAjuste;

        // 3) redondeamos a 2 decimales
        importeAjuste = Math.Round(importeAjuste, 2, MidpointRounding.AwayFromZero);

        // Id especial para identificar que es un ajuste
        int formaPagoId = _esDescuento ? -1 : -2;

        var pagoDetalle = new PagoDetalle
        {
            FormaPagoId = formaPagoId,
            FormaPagoNombre = nombreFormaPago,
            Importe = importeAjuste,   // ojo: recargo va NEGATIVO
            Moneda = "PESOS"
        };

        // Agregamos el ajuste como si fuera una "forma de pago" más
        _pagos.Add(pagoDetalle);

        // Notificamos al padre y refrescamos totales
        await NotificarCambiosAsync();
    }




    // ---------- Cálculos ----------

    private decimal CalcularImporteDescuentoRecargo(decimal totalBase, AjusteLinea ajuste)
    {
        if (ajuste.Tipo == "MONTO_FIJO")
            return ajuste.Valor; // ya viene en pesos

        // tipo porcentual: aplico % sobre el total base
        var importe = totalBase * (ajuste.Valor / 100m);
        return Math.Round(importe, 2);
    }


    /// <summary>Total de la venta en PESOS: suma de PrecioLista de los productos.</summary>
    private decimal TotalVenta =>
    Math.Round(
        (Productos != null && GetPrecioLista != null)
            ? Productos.Sum(p => GetPrecioLista(p))
            : 0m,
        2,
        MidpointRounding.AwayFromZero
    );

    private decimal TotalPagadoPesos =>
        Math.Round(
            _pagos.Sum(p =>
                (p.SimboloMoneda?.Trim().ToUpper() == "USD")
                    ? p.Importe * _cotizacionActual
                    : p.Importe
            ),
            2,
            MidpointRounding.AwayFromZero
        );

    private decimal TotalUsd =>
        Math.Round(
            _cotizacionActual > 0 ? TotalVenta / _cotizacionActual : 0m,
            2,
            MidpointRounding.AwayFromZero
        );

    private decimal RestanPesos =>
        Math.Round(
            TotalVenta - TotalPagadoPesos,
            2,
            MidpointRounding.AwayFromZero
        );

    private decimal RestanUsd =>
        Math.Round(
            _cotizacionActual > 0 ? RestanPesos / _cotizacionActual : 0m,
            2,
            MidpointRounding.AwayFromZero
        );

    private decimal Cambio =>
        Math.Round(
            RestanPesos < 0 ? Math.Abs(RestanPesos) : 0m,
            2,
            MidpointRounding.AwayFromZero
        );



    // ---------- Clases auxiliares ----------
    public class PagoDetalle
    {
        public int FormaPagoId { get; set; }
        public string FormaPagoNombre { get; set; } = "";
        public decimal Importe { get; set; }   // SIEMPRE en pesos
        public string Moneda { get; set; }  // "ARS" o "USD"

        public string SimboloMoneda =>
     Moneda?.Trim().ToUpper() switch
     {
         "PESOS" => "$",
         "$" => "$",
         "ARS" => "$",
         "USD" => "USD",
         "DOLARES" => "USD",
         _ => "$"  // valor por defecto
     };
    }

    // ---------- Métodos ----------
    private async Task OnPagoParcialClick()
    {
        if (OnPagoParcial.HasDelegate)
            await OnPagoParcial.InvokeAsync();
    }

    private async Task AgregarPago()
    {
        // ✅ Si ya no hay nada pendiente en pesos, no dejo agregar más pagos
        if (RestanPesos <= 0m)
        {
            Snackbar.Add("La venta ya está totalmente pagada. No podés agregar más pagos.", Severity.Warning);
            return;
        }

        if (_formaPagoId == 0 || _importe <= 0)
            return;

        var forma = FormasPago.FirstOrDefault(f => f.IdFormaPago == _formaPagoId);

        var pago = new PagoDetalle
        {
            FormaPagoId = _formaPagoId,
            FormaPagoNombre = forma?.Descripcion ?? "",
            Importe = _importe,
            Moneda = forma?.Descripcion == "DOLAR EFECTIVO" ? "USD" : "$"
        };

        _pagos.Add(pago);
        await PagosChanged.InvokeAsync(_pagos);

        _importe = 0;
        _porcentaje = 0;
        _montoDescRec = 0;

        StateHasChanged();
    }


    private async Task EliminarPago(PagoDetalle pago)
    {
        _pagos.Remove(pago);
        await PagosChanged.InvokeAsync(_pagos);
    }

    private async Task NotificarCambiosAsync()
    {
        await PagosChanged.InvokeAsync(_pagos);
        StateHasChanged();
    }

    // 👇 método público para que el padre agregue pagos externos (pagos parciales)
    public async Task AgregarPagoExternoAsync(PagoDetalle pago)
    {
        _pagos.Add(pago);
        await NotificarCambiosAsync();
    }
}
<style>
    .pago-wrapper {
        border: 1px solid var(--mud-palette-primary);
        border-radius: 6px;
        padding: 12px; /* un poco de aire interno */
        margin-bottom: 16px; /* por si viene algo debajo */
        background-color: var(--mud-palette-background);
    }

    
</style>
