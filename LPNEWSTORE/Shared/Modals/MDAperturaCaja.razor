@using Entities
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using Services
@inject IDialogService DialogService
@inject CajaRegistradoraEmpresaService CajaService
@inject UsuarioSessionService UsuarioSesionService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider Auth

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">

            <MudItem xs="12" md="6">
                <MudPaper Class="p-4" Elevation="0" Style="background:transparent;">
                    <MudText Typo="Typo.h5" Class="font-bold mb-2">APERTURA DE CAJA</MudText>

                    <MudStack Spacing="2">
                        <MudForm @ref="_form">

                            <MudTextField T="string"
                                          Label="Fecha Apertura"
                                          Value="@_aperturaFecha"
                                          Dense="true"
                                          ReadOnly="true" />

                            <MudTextField T="string"
                                          Label="Usuario"
                                          Value="@_usuario"
                                          Dense="true"
                                          ReadOnly="true" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.PointOfSale"
                                       Class="mt-2"
                                       Disabled="_saving"
                                       OnClick="OnAbrirCaja">
                                Abrir Caja
                            </MudButton>

                        </MudForm>
                    </MudStack>
                </MudPaper>
            </MudItem>

           @*  <MudItem xs="12" md="6">
                <MudPaper Class="p-4" Elevation="0" Style="background:transparent;">
                    <MudText Typo="Typo.h5" Class="font-bold mb-2">DETALLE ÚLTIMA CAJA CERRADA</MudText>

                    @if (_ultima is null)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            No existe una caja cerrada previa para esta sucursal.
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            <MudTextField T="string"
                                          Label="Fecha Apertura"
                                          Value="@_ultima.FechaApertura.ToString("dd/MM/yyyy HH:mm")"
                                          Dense="true"
                                          Disabled="true" />

                            <MudTextField T="string"
                                          Label="Fecha Cierre"
                                          Value="@(_ultima.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                          Dense="true"
                                          Disabled="true" />

                            <MudTextField T="string"
                                          Label="Usuario"
                                          Value="@_ultima.UsuarioAperturaCaja"
                                          Dense="true"
                                          Disabled="true" />

                            <MudTextField T="string"
                                          Label="Estado"
                                          Value="@(_ultima.Estado ? "Abierta" : "Cerrada")"
                                          Dense="true"
                                          Disabled="true" />
                        </MudStack>
                    }
                </MudPaper>
            </MudItem> *@

        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="Cancel">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm? _form;

    private string _aperturaFecha = string.Empty;
    private string _usuario => UsuarioSesionService.UserName;
    private bool _saving = false;

    private CajaRegistradoraEmpresa? _ultima;

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await Auth.GetAuthenticationStateAsync();
            var user = authState.User;

            
            _aperturaFecha = DateTime.Now.ToString("dd/MM/yyyy HH:mm");

            // Caja abierta actual
            var cajaActual = await CajaService.ObtenerCajaActual();

            if (cajaActual is not null)
            {
                Snackbar.Add("Ya existe una caja abierta para esta sucursal.", Severity.Warning);
            }

            // Última caja cerrada
            // Este método deberías tenerlo en el service
            _ultima = await CajaService.ObtenerUltimaCajaCerrada();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos de apertura: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnAbrirCaja()
    {
        try
        {
            _saving = true;

            var cajaActual = await CajaService.ObtenerCajaActual();

            if (cajaActual is not null)
            {
                Snackbar.Add("Ya existe una caja abierta. Ciérrela e intente nuevamente.", Severity.Warning);
                return;
            }

            var (idCajaRegistradora, ok, mensaje) = await CajaService.AbrirCaja();

            if (!ok || idCajaRegistradora <= 0)
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(mensaje)
                    ? "No se pudo abrir la caja."
                    : mensaje, Severity.Error);
                return;
            }

            Snackbar.Add(mensaje, Severity.Success);

            var parameters = new DialogParameters
        {
            { nameof(MDSaldosInicialesCaja.IdCajaRegistradora), idCajaRegistradora }
        };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = false
            };

            var dialog = DialogService.Show<MDSaldosInicialesCaja>(
                "Saldos Iniciales",
                parameters,
                options);

            var result = await dialog.Result;

            if (!result.Canceled)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("La caja fue abierta, pero no se cargaron los saldos iniciales.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ocurrió un error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}