@using LPNEWSTORE.Shared.Modals
@using LPNEWSTORE.Shared.Themes
@using MudBlazor
@using LPNEWSTORE.Shared
@using Services
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject EmpresaTemaService EmpresaTemaService
@inject EmpresaService EmpresaService
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@implements IDisposable
@inject NavigationManager NavManager
@inject IModalLauncher Modal
@inject IDialogService Dialogs
@inject UsuarioSessionService UsuarioSesion

 
<MudDialogProvider />
<MudSnackbarProvider />

<MudThemeProvider Theme="@baseTheme" IsDarkMode="@darkMode" />
    
<MudLayout Class="mud-layout-root" Style="min-height: 100vh;">
    <MudAppBar Elevation="1" Dense="true"  DarkModeChanged="OnDarkModeChanged">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />

        <MudText Typo="Typo.h6" Class="ml-2" Style="flex-grow:1;">
            Bienvenido, @usuarioNombre | Rol: @rolUsuario  | Empresa: @empresaActual
        </MudText>

        @if (esAdmin)
        {    
            @* <MudText Typo="Typo.h6" Class="ml-2">
                Sucursal: 
            </MudText>
            <MudSelect T="int" Value="@idSucursal" ValueChanged="CambiarSucursal" Dense="true" Style="min-width: 150px; margin-left: 12px;">
                <MudSelectItem Value="1">Hitech 1</MudSelectItem>
                <MudSelectItem Value="2">Hitech 2</MudSelectItem>
                <MudSelectItem Value="3">Apple Store 49</MudSelectItem>
                <MudSelectItem Value="4">Apple Cafe</MudSelectItem>
            </MudSelect> *@

            <MudText Typo="Typo.h6" Class="ml-2">
                Sucursal: @sucursalActual
            </MudText>

        } else
        {
            <MudText Typo="Typo.h6" Class="ml-2">
                Sucursal: @sucursalActual
            </MudText> 

        }
        <MudButton OnClick="ToggleDarkMode"  Color="Color.Secondary" StartIcon="@GetThemeIcon()">
            @GetThemeText()
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="CerrarSesion"></MudButton>
    </MudAppBar>

    <MudDrawer Variant="DrawerVariant.Responsive"
               Open="@drawerOpen"
               MiniVariant="@miniDrawer"
               Anchor="Anchor.Start"
               Elevation="1"
               Class="drawer-col">

        <div class="drawer-inner">
            @* <- único scroll *@
            <div class="drawer-header">
                <div class="drawer-logo-box">
                    <img src="@logoUrl" alt="Logo Empresa" class="drawer-logo-img" />
                </div>
            </div>

            <MudNavMenu Dense="true" Class="nav-compact">
                @if (esAdmin)
                {
                    <AdminMenu OnNavigationItemClicked="CerrarDrawer" />
                }
                else if (esVendedor)
                {
                    <VendedorMenu OnNavigationItemClicked="CerrarDrawer" />
                }
            </MudNavMenu>
        </div>
    </MudDrawer>



    <MudMainContent Style="overflow-y:auto;">
        @Body
    </MudMainContent>

    <MudPopoverProvider />
</MudLayout>








@code {
    private bool darkMode;
    private MudTheme baseTheme = new RoyalTechTheme();

    private string logoUrl = "/images/logoRoyalTech.png";
    private string empresaActual = "";
    private string sucursalActual = "";
    private string usuarioNombre = "";
    private string rolUsuario = "";

    private int idEmpresa;
    private int idSucursal;

    private bool esAdmin = false;
    private bool esVendedor = false;

    private bool drawerOpen = true;
    private bool miniDrawer = false;

    private string GetThemeIcon() => darkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode;
    private string GetThemeText() => darkMode ? "Modo Oscuro" : "Modo Claro";

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
        Modal.OnOpenAperturaCaja += ShowAperturaCajaAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                esAdmin = user.IsInRole("ADMIN");
                esVendedor = user.IsInRole("VENDEDOR");

                usuarioNombre = user.FindFirst("NombreCompleto")?.Value
                                ?? user.Identity.Name
                                ?? "Invitado";

                empresaActual = user.FindFirst("NombreEmpresa")?.Value ?? "Royal Tech";
                sucursalActual = user.FindFirst("NombreNegocio")?.Value ?? "Sin sucursal";

                var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role)
                                .Select(r => r.Value);
                rolUsuario = roles.Any() ? string.Join(", ", roles) : "Sin rol";

                int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out int idUsuario);
                int.TryParse(user.FindFirst("IdEmpresa")?.Value, out idEmpresa);
                int.TryParse(user.FindFirst("IdNegocio")?.Value, out idSucursal);

                UsuarioSesion.IdUsuario = idUsuario;
                UsuarioSesion.IdEmpresa = idEmpresa;
                UsuarioSesion.IdNegocio = idSucursal;
                UsuarioSesion.Rol = rolUsuario;
                UsuarioSesion.UserName = usuarioNombre;
                UsuarioSesion.NombreEmpresa = empresaActual;
                UsuarioSesion.NombreNegocio = sucursalActual;
                UsuarioSesion.EsAdmin = esAdmin;
                UsuarioSesion.EsVendedor = esVendedor;

                // valores por defecto
                baseTheme = new RoyalTechTheme();
                darkMode = false;
                logoUrl = "/images/logoRoyalTech.png";

                if (idEmpresa > 0)
                {
                    var temaEmpresa = await EmpresaTemaService.ObtenerTemaPorEmpresa(idEmpresa);
                    var ( logoBytes, logoEmpresa) = await EmpresaService.ObtenerLogo(idEmpresa);
                    if (temaEmpresa != null)
                    {
                        baseTheme = ThemeFactory.CrearTema(temaEmpresa);
                        darkMode = temaEmpresa.ModoOscuro;
                    }
                    else
                    {
                        baseTheme = new RoyalTechTheme();
                        darkMode = false;
                    }

                    if (logoEmpresa && logoBytes != null && logoBytes.Length > 0)
                    {
                        logoUrl = $"data:image/png;base64,{Convert.ToBase64String(logoBytes)}";
                    }
                    else
                    {
                        logoUrl = "/images/logoRoyalTech.png";
                    }
                }
            }
            else
            {
                baseTheme = new RoyalTechTheme();
                logoUrl = "/images/logoRoyalTech.png";
                darkMode = false;

                empresaActual = "";
                sucursalActual = "";
                usuarioNombre = "";
                rolUsuario = "";

                UsuarioSesion.IdUsuario = 0;
                UsuarioSesion.IdEmpresa = 0;
                UsuarioSesion.IdNegocio = 0;
                UsuarioSesion.Rol = "";
                UsuarioSesion.UserName = "";
                UsuarioSesion.NombreEmpresa = "";
                UsuarioSesion.NombreNegocio = "";
                UsuarioSesion.EsAdmin = false;
                UsuarioSesion.EsVendedor = false;
            }
        }
        catch (Exception ex)
        {
            baseTheme = new RoyalTechTheme();
            logoUrl = "/images/logoRoyalTech.png";
            darkMode = false;

            Console.WriteLine($"Error cargando MainLayout: {ex}");
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedDarkMode = await JS.InvokeAsync<string>("tema.obtenerModoOscuro");

                if (!string.IsNullOrWhiteSpace(savedDarkMode) && bool.TryParse(savedDarkMode, out var parsed))
                    darkMode = parsed;
                else
                    darkMode = false;

                StateHasChanged();
            }
            catch
            {
                darkMode = false;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleDarkMode()
    {
        darkMode = !darkMode;
        await JS.InvokeVoidAsync("tema.guardarModoOscuro", darkMode.ToString());
        StateHasChanged();
    }

    private async Task OnDarkModeChanged(bool value)
    {
        darkMode = value;
        await JS.InvokeVoidAsync("tema.guardarModoOscuro", darkMode.ToString());
        StateHasChanged();
    }

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
        StateHasChanged();
    }

    private void CerrarDrawer()
    {
        drawerOpen = false;
        miniDrawer = true;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CerrarDrawer();
    }

    private async Task ShowAperturaCajaAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dlg = Dialogs.Show<MDAperturaCaja>("Apertura Caja", options);
        var result = await dlg.Result;

        if (!result.Canceled)
            StateHasChanged();
    }

    private void CerrarSesion()
    {
        Navigation.NavigateTo("/Logout", forceLoad: true);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        Modal.OnOpenAperturaCaja -= ShowAperturaCajaAsync;
    }
}

}
