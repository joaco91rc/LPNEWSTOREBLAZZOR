@page "/monedas"
@using MudBlazor
@using Services
@using Entities

@inject MonedaEmpresaService MonedaEmpresaService
@inject ISnackbar Snackbar

<PageTitle>Configuración de Moneda</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">

    <MudStack Spacing="3">

        <MudPaper Class="pa-5 rounded-xl">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudAvatar Size="Size.Large" Color="Color.Success" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" />
                </MudAvatar>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5" Color="Color.Primary">Configuración de moneda</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Definí cómo se mostrará la moneda principal de la empresa en todo el sistema.
                    </MudText>
                </MudStack>
            </MudStack>

            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined"
                      Dense="true"
                      Class="mt-3">
                El sistema trabaja con dos monedas lógicas:
                <b>Moneda principal</b> y <b>USD</b>.
                Desde esta pantalla configurás solamente la moneda principal.
            </MudAlert>
        </MudPaper>

        <MudGrid Spacing="3">

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-5 rounded-xl h-100">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">Moneda principal</MudText>
                        </MudStack>

                        <MudForm @ref="formMoneda">
                            <MudGrid Spacing="2">

                                <MudItem xs="12">
                                    <MudTextField Label="Nombre de la moneda"
                                                  @bind-Value="MonedaPrincipal.Nombre"
                                                  Required="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Placeholder="Ej: Peso Argentino, Euro, Peso Uruguayo"
                                                  Immediate="true"
                                                  Style="text-transform: uppercase;" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="Símbolo"
                                                  @bind-Value="MonedaPrincipal.Simbolo"
                                                  Required="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Placeholder="Ej: $, €, $U"
                                                  Immediate="true"
                                                  Style="text-transform: uppercase;" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="Código ISO"
                                                  @bind-Value="MonedaPrincipal.CodigoISO"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Placeholder="Ej: ARS, EUR, UYU"
                                                  Immediate="true"
                                                  Style="text-transform: uppercase;" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudChip T="string " Color="@(MonedaPrincipal.IdMoneda == 1 ? Color.Primary : Color.Success)">
                                @(MonedaPrincipal.IdMoneda == 1 ? "PRINCIPAL" : "USD")
                                    </MudChip>
                                </MudItem>

                            </MudGrid>
                        </MudForm>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-5 rounded-xl h-100">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.CurrencyExchange" Color="Color.Success" />
                            <MudText Typo="Typo.h6">USD de referencia</MudText>
                        </MudStack>

                        <MudDivider />

                        <MudText Typo="Typo.body2">
                            <b>Nombre:</b> @(MonedaUsd?.Nombre ?? "DÓLAR ESTADOUNIDENSE")
                        </MudText>

                        <MudText Typo="Typo.body2">
                            <b>Símbolo:</b> @(MonedaUsd?.Simbolo ?? "USD")
                        </MudText>

                        <MudText Typo="Typo.body2">
                            <b>Código ISO:</b> @(MonedaUsd?.CodigoISO ?? "USD")
                        </MudText>

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            Fija en el sistema
                        </MudChip>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-4 rounded-xl">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="Recargar">
                            Cancelar
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="Guardar">
                            Guardar configuración
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

        </MudGrid>

    </MudStack>

</MudContainer>

@code {
    private MudForm? formMoneda;

    private MonedaEmpresa MonedaPrincipal = new()
    {
        IdMoneda = 1,
        Activo = true
    };

    private MonedaEmpresa? MonedaUsd;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            var lista = await MonedaEmpresaService.ListarAsync();

            var principal = lista.FirstOrDefault(x => x.IdMoneda == 1);
            var usd = lista.FirstOrDefault(x => x.IdMoneda == 2);

            if (principal is not null)
            {
                MonedaPrincipal = new MonedaEmpresa
                {
                    IdMonedaEmpresa = principal.IdMonedaEmpresa,
                    IdEmpresa = principal.IdEmpresa,
                    IdMoneda = principal.IdMoneda,
                    Nombre = principal.Nombre,
                    Simbolo = principal.Simbolo,
                    CodigoISO = principal.CodigoISO,
                    Activo = principal.Activo
                };
            }
            else
            {
                MonedaPrincipal = new MonedaEmpresa
                {
                    IdMoneda = 1,
                    Nombre = "",
                    Simbolo = "",
                    CodigoISO = "",
                    Activo = true
                };
            }

            MonedaUsd = usd ?? new MonedaEmpresa
            {
                IdMoneda = 2,
                Nombre = "DÓLAR ESTADOUNIDENSE",
                Simbolo = "USD",
                CodigoISO = "USD",
                Activo = true
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar la configuración de moneda: {ex.Message}", Severity.Error);
        }
    }

    private async Task Guardar()
    {
        if (formMoneda is null)
            return;

        await formMoneda.Validate();

        if (!formMoneda.IsValid)
        {
            Snackbar.Add("Completá los campos requeridos.", Severity.Warning);
            return;
        }

        MonedaPrincipal.Nombre = MonedaPrincipal.Nombre?.Trim().ToUpperInvariant() ?? string.Empty;
        MonedaPrincipal.Simbolo = MonedaPrincipal.Simbolo?.Trim().ToUpperInvariant() ?? string.Empty;
        MonedaPrincipal.CodigoISO = MonedaPrincipal.CodigoISO?.Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(MonedaPrincipal.Nombre))
        {
            Snackbar.Add("Ingresá el nombre de la moneda principal.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(MonedaPrincipal.Simbolo))
        {
            Snackbar.Add("Ingresá el símbolo de la moneda principal.", Severity.Warning);
            return;
        }

        if (MonedaPrincipal.Simbolo.Length > 10)
        {
            Snackbar.Add("El símbolo no puede superar los 10 caracteres.", Severity.Warning);
            return;
        }

        try
        {
            bool ok;
            string mensaje;

            if (MonedaPrincipal.IdMonedaEmpresa > 0)
            {
                (ok, mensaje) = await MonedaEmpresaService.EditarAsync(MonedaPrincipal);
            }
            else
            {
                MonedaPrincipal.IdMoneda = 1;
                MonedaPrincipal.Activo = true;
                (ok, mensaje) = await MonedaEmpresaService.RegistrarAsync(MonedaPrincipal);
            }

            if (ok)
            {
                Snackbar.Add(mensaje, Severity.Success);
                await CargarDatos();
                formMoneda.ResetValidation();
            }
            else
            {
                Snackbar.Add(mensaje, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar la configuración: {ex.Message}", Severity.Error);
        }
    }

    private async Task Recargar()
    {
        await CargarDatos();

        if (formMoneda is not null)
            formMoneda.ResetValidation();
    }
}