        display: flex;
        flex-direction: column;
        height: calc(100vh - 70px); /* resta la barra superior */
    }

    /* TODO LO QUE VA ARRIBA DEL FOOTER */
    .venta-content {
        flex: 1 1 auto;
        overflow-y: auto; /* permite scroll SOLO al contenido de arriba */
        padding-bottom: 16px;
    }

    /* FOOTER FIJO SIEMPRE VISIBLE */
    .venta-footer {
        flex: 0 0 auto;
        border-top: 1px solid var(--mud-palette-primary);
        padding-top: 8px;
    }

    .registrar-btn-container {
        width: 100%;
        display: flex;
        justify-content: flex-end;
        padding: 16px 24px; /* separado del borde */
        box-sizing: border-box;
    }

</style>