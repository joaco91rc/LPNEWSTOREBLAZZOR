@page "/registrarventa"
@using LPNEWSTORE.Shared.Components
@using Entities
@using LPNEWSTORE.Shared.Modals
@using MudBlazor
@using Services
@using System.Data
@using System.Text
@using static LPNEWSTORE.Shared.Components.CabeceraSelector
@inject FormaPagoService FormaPagoService
@inject VendedorService VendedorService
@inject CotizacionService CotizacionService
@inject VentaEmpresaService VentaEmpresaService
@inject PagoParcialService PagoParcialService
@inject ClienteService ClienteNegocioService
@inject ProductoNegocioService ProductoNegocioService
@inject ProductoService ProductoService
@inject ProductoDetalleService ProductoDetalleService

@inject TransaccionCajaEmpresaService TransaccionCajaEmpresaService
@inject CajaRegistradoraEmpresaService CajaRegistradoraEmpresaService
@inject CajaRegistradoraEmpresaDetalleService CajaRegistradoraDetalleService
@inject FormaPagoService FormaPagoService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<div class="venta-container">

    <div class="venta-content">
        <CabeceraSelector EsVenta="true"
                          @bind-Fecha="vm.Fecha"
                          TiposDocumento="vm.TiposDocumento"
                          @bind-TipoDocumento="vm.TipoDocumento"
                          Vendedores="vm.Vendedores"
                          @bind-VendedorId="vm.VendedorId"
                          @bind-DocumentoPersona="vm.DniCliente"
                          @bind-NombrePersona="vm.NombreCliente"
                          OnBuscarPersona="AbrirMDCliente" />

        <DetalleProductoSelector @bind-Items="_detalle"
                                 CotizacionInicialUsd="_cotizacionActual"
                                 IdSucursal="_idSucursal" />
    </div>

    <div class="venta-footer">
        <FormaPagoSelector TProducto="DetalleProductoSelector.DetalleProductoItem"
                           @ref="_formaPagoSelector"
                           FormasPago="@_formasPago"
                           Productos="@_detalle"
                           GetPrecioLista="@(p => p.SubTotalPesos)"
                           PagosChanged="OnPagosChanged"
                           OnPagoParcial="AbrirModalPagosParciales" />
    </div>
    <div class="registrar-btn-container">
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="RegistrarVentaEmpresa"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.TwoTone.MonetizationOn">
            Registrar
        </MudButton>
    </div>

</div>





@code {


    private List<FormaPago> _formasPago = new();
    private FormaPagoSelector<DetalleProductoSelector.DetalleProductoItem>? _formaPagoSelector;

    private VentaViewModel vm = new();
    private List<Producto> _productos = new(); // la lista que ya usás en la venta
    private List<DetalleProductoSelector.DetalleProductoItem> _detalle = new();
    private decimal _cotizacionActual;
    private int _idSucursal;
    private Usuario _usuarioLogueado;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // 👉 Usuario logueado
        string? idUsuarioString = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idUsuarioString, out var idParsed))
        {
            _usuarioLogueado ??= new Usuario();
            _usuarioLogueado.Id = idParsed;
            _usuarioLogueado.UserName = user.Identity?.Name;
        }

        // 👉 Sucursal desde CLAIM (reemplaza getCookie)
        string? idSucursalClaim = user.FindFirst("IdNegocio")?.Value;
        if (int.TryParse(idSucursalClaim, out var idSucursal))
        {
            _idSucursal = idSucursal;
        }

        // Lanzás todas las tareas en paralelo
        var cotizacionTask = CotizacionService.CotizacionActiva();
        var formasPagoTask = FormaPagoService.ListarFormasDePago();
        var vendedoresTask = VendedorService.ListarVendedores();

        // Esperás todas juntas
        await Task.WhenAll(cotizacionTask, formasPagoTask, vendedoresTask);

        // Asignás resultados
        _cotizacionActual = cotizacionTask.Result?.Importe ?? 0;
        _formasPago = formasPagoTask.Result ?? new List<FormaPago>();
        vm.Vendedores = vendedoresTask.Result ?? new List<Vendedor>();


        // 👉 Tipos de documento
        vm.TiposDocumento = new List<OpcionDocumento>
    {
        new() { Valor = "Factura A", Texto = "Factura A" },
        new() { Valor = "Factura B", Texto = "Factura B" },
        new() { Valor = "Factura C", Texto = "Factura C" },
        new() { Valor = "Remito R",  Texto = "Remito R" },
        new() { Valor = "Presupuesto", Texto = "Presupuesto" }
    };

        // 👉 Defaults
        if (vm.Vendedores is { Count: > 0 })
            vm.VendedorId = vm.Vendedores[0].IdVendedor;

        if (vm.TiposDocumento is { Count: > 0 })
            vm.TipoDocumento = vm.TiposDocumento[0].Valor;
    }

    private async Task RegistrarVentaEmpresa()
    {
        if (!ValidarFormulario())
            return;

        var venta = CrearVentaEmpresa();

        var resultado = await VentaEmpresaService.RegistrarAsync(venta);

        if (!resultado.resultado)
        {
            Snackbar.Add($"Error al registrar la venta: {resultado.mensaje}", Severity.Error);
            return;
        }

        int idVentaGenerado = resultado.idVenta;

        try
        {
            await DarDeBajaPagosParcialesAsync(idVentaGenerado);

            if (vm.ClienteId.HasValue)
            {
                var perteneceANegocio = await ClienteNegocioService.ClienteAsignadoANegocio(vm.ClienteId.Value, _idSucursal);

                if (!perteneceANegocio)
                {
                    await ClienteNegocioService.AsignarClienteANegocio(vm.ClienteId.Value, _idSucursal);
                }
            }

            string stockActualizado = await ActualizarStockAsync(idVentaGenerado);
            string mensajeTransaccion = await RegistrarTransaccionesCajaAsync(venta, idVentaGenerado);

            Snackbar.Add(
                $"Venta registrada correctamente. Número: {idVentaGenerado}. {stockActualizado} {mensajeTransaccion}",
                Severity.Success);

            await LimpiarVentaAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"La venta se registró, pero ocurrió un error posterior: {ex.Message}", Severity.Warning);
        }
    }

    private bool ValidarFormulario()
    {
        // Documento cliente
        if (string.IsNullOrWhiteSpace(vm.DniCliente))
        {
            Snackbar.Add("Debe ingresar el documento del cliente", Severity.Error);
            return false;
        }

        // Nombre cliente
        if (string.IsNullOrWhiteSpace(vm.NombreCliente))
        {
            Snackbar.Add("Debe ingresar el nombre del cliente", Severity.Error);
            return false;
        }

        // Productos (detalle)
        if (_detalle is null || !_detalle.Any())
        {
            Snackbar.Add("Debe ingresar productos en la venta", Severity.Error);
            return false;
        }

        // Descuento (cuando lo tengas implementado en Blazor, ajustás esto)
        /*
        if (vm.AplicarDescuento && (vm.PorcentajeDescuento is null || vm.PorcentajeDescuento <= 0))
        {
            Snackbar.Add("Debe ingresar un porcentaje de descuento", Severity.Error);
            return false;
        }
        */

        // Formas de pago
        var pagos = _formaPagoSelector?.Pagos
                    ?? new List<FormaPagoSelector<DetalleProductoSelector.DetalleProductoItem>.PagoDetalle>();

        if (!pagos.Any())
        {
            Snackbar.Add("Debe agregar al menos una forma de pago al detalle de la venta", Severity.Error);
            return false;
        }

        // Vendedor
        if (!vm.VendedorId.HasValue || vm.VendedorId.Value <= 0)
        {
            Snackbar.Add("Debe seleccionar el Vendedor", Severity.Error);
            return false;
        }

        return true;
    }


    private async Task LimpiarVentaAsync()
    {
        // --- Cliente ---
        vm.ClienteId = null;
        vm.DniCliente = string.Empty;
        vm.NombreCliente = string.Empty;

        // Podés mantener la fecha o volver a hoy
        vm.Fecha = DateTime.Today;

        // --- Detalle de productos ---
        _detalle.Clear();

        // --- Formas de pago ---
        if (_formaPagoSelector is not null)
        {
            // Método que vas a agregar en el componente hijo
            await _formaPagoSelector.LimpiarAsync();
        }

        // --- Datos “extra” de la venta (observaciones, descuentos, etc.) ---
        // Si después agregás estos campos al ViewModel o a la página,
        // los reseteás acá. Ejemplos:
        //
        // vm.Observaciones = string.Empty;
        // DescuentoPorcentaje = 0;
        // MontoDescuento = 0;
        // PagaCon = 0;
        // CambioCliente = 0;
        // TotalPesos = 0;
        // TotalDolares = 0;
        // RestaPagarPesos = 0;
        // RestaPagarDolares = 0;
        // IdPagoParcial = 0;
        // _isUpdated = false;
        // AplicaDescuento = false;

        // --- Vendedor y tipo de documento (los dejo en el primer ítem) ---
        if (vm.Vendedores is { Count: > 0 })
            vm.VendedorId = vm.Vendedores[0].IdVendedor;

        if (vm.TiposDocumento is { Count: > 0 })
            vm.TipoDocumento = vm.TiposDocumento[0].Valor;

        StateHasChanged();
    }




    private VentaEmpresa CrearVentaEmpresa()
    {
        var vendedor = vm.Vendedores?.FirstOrDefault(v => v.IdVendedor == (vm.VendedorId ?? 0));

        var pagos = _formaPagoSelector?.Pagos
            ?? new List<FormaPagoSelector<DetalleProductoSelector.DetalleProductoItem>.PagoDetalle>();

        decimal subtotal = _detalle.Sum(x => x.SubTotalPesos);
        decimal totalPagado = pagos
            .Where(x => x.FormaPagoId != 9999)
            .Sum(x => x.Importe);

        var venta = new VentaEmpresa
        {
            IdUsuario = _usuarioLogueado?.Id,
            IdNegocio = _idSucursal,
            IdCliente = vm.ClienteId,
            IdVendedor = vm.VendedorId,

            FechaRegistro = vm.Fecha ?? DateTime.Now,
            TipoDocumento = vm.TipoDocumento,
            DocumentoCliente = vm.DniCliente,
            NombreCliente = vm.NombreCliente,

            Subtotal = subtotal,
            DescuentoTotal = 0,
            RecargoTotal = 0,
            Total = subtotal,
            MontoPagado = totalPagado,
            Vuelto = totalPagado > subtotal ? totalPagado - subtotal : 0,

            CotizacionDolar = _cotizacionActual,
            Observacion = ""
        };

        venta.Detalles = _detalle.Select(item => new DetalleVentaEmpresa
        {
            IdProducto = item.IdProducto,
            DescripcionProducto = item.Nombre,
            Cantidad = item.Cantidad,
            PrecioVenta = item.PrecioLista,
            CostoProducto = item.PrecioCompra,
            Descuento = 0,
            Recargo = 0,
            SubTotal = item.SubTotalPesos,
            FechaRegistro = vm.Fecha ?? DateTime.Now,
            Estado = true
        }).ToList();

        venta.Pagos = pagos
            .Where(p => p.FormaPagoId != 9999)
            .Select(p => new VentaPagoEmpresa
            {
                IdFormaPago = p.FormaPagoId,
                DescripcionFormaPago = p.FormaPagoNombre,
                Moneda = p.Moneda,
                Monto = p.Importe,
                MontoRecibido = p.Importe,
                Vuelto = 0,
                CotizacionDolar = _cotizacionActual,
                PorcentajeRecargo = 0,
                PorcentajeDescuento = 0,
                PorcentajeRetencion = 0,
                Observacion = null,
                FechaRegistro = vm.Fecha ?? DateTime.Now,
                Estado = true
            }).ToList();

        return venta;
    }



    private async Task DarDeBajaPagosParcialesAsync(int idVentaGenerado)
    {
        var pagos = _formaPagoSelector?.Pagos
                    ?? new List<FormaPagoSelector<DetalleProductoSelector.DetalleProductoItem>.PagoDetalle>();

        foreach (var pago in pagos)
        {
            var formaPago = pago.FormaPagoNombre;

            if (!string.IsNullOrWhiteSpace(formaPago) &&
                formaPago.StartsWith("PAGO PARCIAL", StringComparison.OrdinalIgnoreCase))
            {
                bool ok = await PagoParcialService.DarDeBaja(pago.FormaPagoId, idVentaGenerado);

                if (!ok)
                {
                    Snackbar.Add("No se pudo dar de baja el pago parcial", Severity.Warning);
                }
            }
        }
    }

    private async Task<string> ActualizarStockAsync(int idVentaGenerado)
    {
        var sb = new StringBuilder();

        foreach (var item in _detalle)
        {
            int idProducto = item.IdProducto;
            int cantidad = (int)item.Cantidad;

            string nombreProducto = await ProductoService.ObtenerNombreProductoAsync(idProducto);

            await ProductoNegocioService.CargarOActualizarStockProductoAsync(idProducto, _idSucursal, -cantidad);

            sb.AppendLine($"Stock actualizado para el producto {nombreProducto}, cantidad reducida en {cantidad}.");

            if (!string.IsNullOrWhiteSpace(item.SerialNumber))
            {
                var (actualizarSerial, mensaje) =
                    await ProductoDetalleService.DesactivarProductoDetalleAsync(item.IdProductoDetalle, idVentaGenerado);

                if (actualizarSerial != 0)
                    sb.AppendLine($"Número de serie desactivado para el producto {nombreProducto}.");
                else
                    sb.AppendLine($"Error al desactivar el número de serie para el producto {nombreProducto}: {mensaje}");
            }
        }

        return sb.ToString();
    }

    private async Task<string> RegistrarTransaccionesCajaAsync(VentaEmpresa venta, int idVentaGenerado)
    {
        var sb = new StringBuilder();

        foreach (var pago in venta.Pagos)
        {
            if (pago.Monto <= 0 || string.IsNullOrWhiteSpace(pago.DescripcionFormaPago))
                continue;

            string formaPago = pago.DescripcionFormaPago;

            if (formaPago.Equals("DESCUENTO", StringComparison.OrdinalIgnoreCase) ||
                formaPago.Equals("RECARGO", StringComparison.OrdinalIgnoreCase) ||
                formaPago.StartsWith("PAGO PARCIAL", StringComparison.OrdinalIgnoreCase))
            {
                sb.AppendLine($"Movimiento omitido para la forma de pago: {formaPago}.");
                continue;
            }

            var fp = await FormaPagoService.ObtenerFPPorDescripcion(formaPago);

            if (fp == null)
            {
                sb.AppendLine($"Error: No se encontró la forma de pago: {formaPago}.");
                continue;
            }

            if (fp.IdCajaAsociada <= 0)
            {
                sb.AppendLine($"Error: La forma de pago {formaPago} no tiene caja asociada.");
                continue;
            }

            var cajaRegistradoraAbierta = await CajaRegistradoraEmpresaService.ObtenerCajaActual();

            if (cajaRegistradoraAbierta == null)
            {
                sb.AppendLine("No hay una caja registradora abierta para registrar el movimiento.");
                continue;
            }

            var vendedor = vm.Vendedores?.FirstOrDefault(v => v.IdVendedor == vm.VendedorId);
            string nombreVendedor = vendedor is not null
                ? $"{vendedor.Nombre}, {vendedor.Apellido}"
                : string.Empty;

            var transaccion = new TransaccionCajaEmpresa
            {
                IdCajaRegistradora = cajaRegistradoraAbierta.IdCajaRegistradora,
                IdCaja = fp.IdCajaAsociada,
                IdEmpresa = cajaRegistradoraAbierta.IdEmpresa,
                IdNegocio = _idSucursal,

                FechaTransaccion = DateTime.Now,
                TipoTransaccion = "INGRESO",
                TipoOperacion = "VENTA",

                Monto = pago.Monto,
                Detalle = $"Venta Número: {idVentaGenerado} Cliente: {venta.NombreCliente}",
                UsuarioTransaccion = nombreVendedor,

                IdFormaPago = fp.IdFormaPago,
                IdVenta = idVentaGenerado,
                IdCompra = null,
                IdPagoParcial = null,
                IdConcepto = null,

                DescripcionCaja = fp.NombreCajaAsociada,
                DescripcionFormaPago = formaPago
            };

            var (idTransaccionGenerada, mensaje) =
                await TransaccionCajaEmpresaService.RegistrarMovimientoCompletoAsync(transaccion);

            if (idTransaccionGenerada > 0)
                sb.AppendLine($"Movimiento registrado con éxito para {formaPago}, monto: {pago.Monto}.");
            else
                sb.AppendLine($"Error al registrar movimiento para {formaPago}: {mensaje}.");
        }

        return sb.ToString();
    }


    private void OnPagosChanged(List<FormaPagoSelector<DetalleProductoSelector.DetalleProductoItem>.PagoDetalle> pagos)
    {
        // acá podés actualizar la Venta, Caja, etc.
    }

    private async Task AbrirModalPagosParciales()
    {
        var parameters = new DialogParameters
        {
            { nameof(MDPagoParcial.IdCliente), vm.ClienteId },
            // { nameof(MDPagoParcial.TotalPendiente), TotalPendiente },
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = DialogService.Show<MDPagoParcial>("Pago parcial", parameters, options);
        var result = await dialog.Result;

        // OJO: es Cancelled, no Canceled
        if (!result.Canceled && result.Data is PagoParcial pagoParcial)
        {
            // armamos el PagoDetalle que usa el selector
            var pagoDetalle = new FormaPagoSelector<DetalleProductoSelector.DetalleProductoItem>.PagoDetalle
            {
                FormaPagoId = pagoParcial.IdPagoParcial,
                // Acá ponemos la leyenda "Pago parcial - "
                FormaPagoNombre = $"Pago Parcial Nro. {pagoParcial.IdPagoParcial} - {pagoParcial.FormaPago}",
                Importe = pagoParcial.Monto,
                Moneda = pagoParcial.Moneda

            };

            // le avisamos al componente hijo que agregue este pago
            await _formaPagoSelector!.AgregarPagoExternoAsync(pagoDetalle);
        }
    }

    private async Task AbrirMDCliente()
    {
        var parameters = new DialogParameters
        {
            // { nameof(MDPagoParcial.IdCliente), 142 },
            // { nameof(MDPagoParcial.TotalPendiente), TotalPendiente },
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = DialogService.Show<MDCliente>("Clientes", parameters, options);
        var result = await dialog.Result;

        // OJO: es Cancelled, no Canceled
        if (!result.Canceled && result.Data is Cliente cliente)
        {
            vm.DniCliente = cliente.Documento;
            vm.NombreCliente = cliente.NombreCompleto;
            vm.ClienteId = cliente.IdCliente;
        }
    }

    public class VentaViewModel
    {
        public DateTime? Fecha { get; set; } = DateTime.Today;


        public int? VendedorId { get; set; }
        public int? ClienteId { get; set; }
        public string? DniCliente { get; set; }
        public string? NombreCliente { get; set; }
        public string? NombreVendedor { get; set; }

        public string? TipoDocumento { get; set; }       // ej: "Factura A"
        public List<OpcionDocumento> TiposDocumento { get; set; } = new();

        public List<Vendedor>? Vendedores { get; set; }
    }

}

<style>

