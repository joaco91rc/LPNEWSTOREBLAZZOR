<ReportListLayout TItem="OrdenTrabajo"
                  Items="@_OrdenTrabajosFiltradas"
                  FilterColumns="@(new[] { "Nro. Orden Trabajo" ,"Fecha", "Estado", "Cliente", "Equipo", "Tipo", "Marca", "Modelo", "S/N", "Problema" })"
                  OnSearchParameters="DoSearch"
                  OnFilter="DoFilter"
                  OnClearParameters="DoClearSearch"
                  OnClearFilter="DoClearFilter"
                  OnExport="DoExport">

    <Columns>
        <PropertyColumn T="OrdenTrabajo" TProperty="int" Property="e => e.IdOrdenTrabajo"
                        Title="Nro. Orden Trabajo"
                        Visible="false" />

        <PropertyColumn T="OrdenTrabajo" TProperty="DateTime" Property="e => e.FechaGeneracion"
                        Title="Fecha" Format="dd/MM/yyyy" />

        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.Estado"
                        Title="Estado" />

        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.ServicioTecnico.NombreCliente"
                        Title="Cliente" />

        

        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.ServicioTecnico.Producto"
                        Title="Equipo" />

        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.ServicioTecnico.TipoEquipo"
                        Title="Tipo" />

        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.ServicioTecnico.Marca"
                        Title="Marca" />
        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.ServicioTecnico.Modelo"
                        Title="Modelo" />
        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.ServicioTecnico.SerialNumber"
                        Title="S/N" />
        <PropertyColumn T="OrdenTrabajo" TProperty="string" Property="e => e.ServicioTecnico.DescripcionProblema"
                        Title="Problema" />

        <TemplateColumn T="OrdenTrabajo" Title="Acciones" Align="DataGridColumnAlign.Center" Width="160px">
            <CellTemplate Context="row">
                <MudIconButton Size="Size.Small"
                               Icon="@Icons.Material.Filled.Edit"
                               OnClick="@(()=>ImprimirOrdenTrabajo(row.Item))" />
                
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</ReportListLayout>


