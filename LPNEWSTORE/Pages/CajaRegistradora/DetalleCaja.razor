<!-- Título centrado con espacio antes de la navbar -->
<MudText Typo="Typo.h6"
         Color="Color.Primary"
         Align="Align.Center"
         Class="mb-3">
    @if (CajaPorFechaElegida is not null)
    {
        @($"Detalle de Transacciones de la Caja Registradora desde el {CajaPorFechaElegida.FechaApertura:dd/MM/yyyy HH:mm} " +
            $"hasta el {(CajaPorFechaElegida.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "Sin cerrar")}")
        }
</MudText>


@if (CajaPorFechaElegida is not null && CajaPorFechaElegida.IdCajaRegistradora > 0)
{
    var totalIngresos = _TransaccionCajas
        .Where(x => x.TipoTransaccion?.ToUpper() == "INGRESO")
        .Sum(x => x.Monto);

    var totalEgresos = _TransaccionCajas
        .Where(x => x.TipoTransaccion?.ToUpper() == "EGRESO")
        .Sum(x => x.Monto);

    var saldoFinal = DetallesCajaElegida.Sum(x => x.SaldoActual);
    var saldoInicial = DetallesCajaElegida.Sum(x => x.SaldoInicial);

    <MudPaper Class="pa-5 mb-4" Elevation="2" Style="border-radius:18px;">
        <MudGrid Spacing="3">

            <MudItem xs="12" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Apertura</MudText>
                <MudText Typo="Typo.body1">
                    @CajaPorFechaElegida.FechaApertura.ToString("dd/MM/yyyy HH:mm")
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Cierre</MudText>
                <MudText Typo="Typo.body1">
                    @CajaPorFechaElegida.FechaCierre?.ToString("dd/MM/yyyy HH:mm")
                </MudText>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Usuarios</MudText>
                <MudText Typo="Typo.body2">
                    Apertura: <b>@CajaPorFechaElegida.UsuarioAperturaCaja</b>
                </MudText>
                <MudText Typo="Typo.body2">
                    Cierre: <b>@CajaPorFechaElegida.UsuarioCierreCaja</b>
                </MudText>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Saldo inicial</MudText>
                <MudText Typo="Typo.h6">
                    @saldoInicial.ToString("C", new System.Globalization.CultureInfo("es-AR"))
                </MudText>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Ingresos</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success">
                    @totalIngresos.ToString("C", new System.Globalization.CultureInfo("es-AR"))
                </MudText>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Egresos</MudText>
                <MudText Typo="Typo.h6" Color="Color.Error">
                    @totalEgresos.ToString("C", new System.Globalization.CultureInfo("es-AR"))
                </MudText>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                    Saldos por caja
                </MudText>

                <MudGrid Spacing="2" Class="mt-2">
                    @foreach (var d in DetallesCajaElegida)
                    {
                        var ingresosCaja = _TransaccionCajas
                        .Where(x => x.IdCaja == d.IdCaja && (x.TipoTransaccion ?? "").ToUpper().Contains("INGR"))
                        .Sum(x => x.Monto);

                        var egresosCaja = _TransaccionCajas
                        .Where(x => x.IdCaja == d.IdCaja && (x.TipoTransaccion ?? "").ToUpper().Contains("EGRE"))
                        .Sum(x => x.Monto);

                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid #e0e0e0; border-radius:14px;">

                                <MudText Typo="Typo.caption" Color="Color.Primary">
                                    @d.DescripcionCaja
                                </MudText>

                                <MudText Typo="Typo.body2">
                                    Inicial: @d.SaldoInicial.ToString("C")
                                </MudText>

                                <MudText Typo="Typo.body2" Color="Color.Success">
                                    Ingresos: @ingresosCaja.ToString("C")
                                </MudText>

                                <MudText Typo="Typo.body2" Color="Color.Error">
                                    Egresos: @egresosCaja.ToString("C")
                                </MudText>

                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1">
                                    Actual: <b>@d.SaldoActual.ToString("C")</b>
                                </MudText>

                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.h6" Align="Align.Right">
                    Saldo final:
                    <b>@saldoFinal.ToString("C", new System.Globalization.CultureInfo("es-AR"))</b>
                </MudText>
            </MudItem>

        </MudGrid>
    </MudPaper>
}
<ReportListLayout TItem="TransaccionCajaEmpresa"
                  Items="@_TransaccionCajasFiltradas"
                  FilterColumns="@(new[] { "Id Transaccion", "Movimiento", "Tipo", "Monto", "Forma de Pago", "Detalle", "Vendedor" })"
                  ShowDateTo="false"
                  OnSearchParameters="DoSearch"
                  OnFilter="DoFilter"
                  OnClearParameters="DoClearSearch"
                  OnClearFilter="DoClearFilter"
                  OnExport="DoExport">

    <Columns>
        <PropertyColumn T="TransaccionCajaEmpresa" TProperty="int"
                        Property="e => e.IdTransaccion"
                        Title="Id TransaccionCaja"
                        Visible="false" />

        <PropertyColumn T="TransaccionCajaEmpresa" TProperty="DateTime"
                        Property="e => e.FechaTransaccion"
                        Title="Movimiento"
                        Format="dd/MM/yyyy HH:mm" />

        <PropertyColumn T="TransaccionCajaEmpresa" TProperty="string"
                        Property="e => e.TipoTransaccion"
                        Title="Tipo Documento" />

        <PropertyColumn T="TransaccionCajaEmpresa" TProperty="decimal"
                        Property="e => e.Monto"
                        Title="Monto"
                        Format="C"
                        Culture="@(new System.Globalization.CultureInfo("es-AR"))" />

        <PropertyColumn T="TransaccionCajaEmpresa" TProperty="string"
                        Property="e => e.DescripcionFormaPago"
                        Title="Forma de pago" />

        <PropertyColumn T="TransaccionCajaEmpresa" TProperty="string"
                        Property="e => e.Detalle"
                        Title="Detalle" />

        <PropertyColumn T="TransaccionCajaEmpresa" TProperty="string"
                        Property="e => e.UsuarioTransaccion"
                        Title="Vendedor" />
    </Columns>
</ReportListLayout>


