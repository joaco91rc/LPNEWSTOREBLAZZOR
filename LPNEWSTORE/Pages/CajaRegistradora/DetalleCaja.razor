@page "/detallecaja"
@using ClosedXML.Excel
@using MudBlazor
@using Microsoft.AspNetCore.Identity
@using Services
@using Entities
@using System.Security.Claims
@using System.Text
@using System.Globalization
@using ClosedXML
@inject TransaccionCajaEmpresaService TransaccionCajaEmpresaService
@inject CajaRegistradoraEmpresaService CajaRegistradoraEmpresaService
@inject CajaRegistradoraEmpresaDetalleService CajaRegistradoraEmpresaDetalleService
@inject RolService rolService
@inject NavigationManager Nav;
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SesionNegocioService SesionNegocioService
@inject IDialogService DialogService
@inject ISnackbar Snackbar





@code {
    private List<string> _cols = new()
    {
        "Id Transaccion", "Movimiento", "Tipo", "Monto", "Forma de Pago", "Detalle", "Vendedor"
    };

    private List<TransaccionCajaEmpresa> Transacciones = new();
    private List<TransaccionCajaEmpresa> _TransaccionCajas = new();
    private List<TransaccionCajaEmpresa> _TransaccionCajasFiltradas = new();

    private CajaRegistradoraEmpresa? CajaPorFechaElegida;
    private List<CajaRegistradoraEmpresaDetalle> DetallesCajaElegida = new();

    private bool _busy;
    private int _idEmpresa;
    private int _idNegocio;

    private DateTime? DateFrom { get; set; }
    private DateTime? DateTo { get; set; }

    





    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            int.TryParse(user.FindFirst("IdEmpresa")?.Value, out _idEmpresa);
            int.TryParse(user.FindFirst("IdNegocio")?.Value, out _idNegocio);
        }
    }

    private async Task CargarCajaPorFechaAsync(DateTime fecha)
    {
        CajaPorFechaElegida = await CajaRegistradoraEmpresaService
            .ObtenerCajaCerradaPorFecha(fecha);

        if (CajaPorFechaElegida is not null && CajaPorFechaElegida.IdCajaRegistradora > 0)
        {
            Transacciones = await TransaccionCajaEmpresaService
                .ListarPorCajaRegistradoraAsync(CajaPorFechaElegida.IdCajaRegistradora);

            DetallesCajaElegida = await CajaRegistradoraEmpresaDetalleService
                .Listar(CajaPorFechaElegida.IdCajaRegistradora);

            _TransaccionCajas = new List<TransaccionCajaEmpresa>(Transacciones);
            _TransaccionCajasFiltradas = new List<TransaccionCajaEmpresa>(_TransaccionCajas);
        }
        else
        {
            Transacciones = new();
            DetallesCajaElegida = new();
            _TransaccionCajas = new();
            _TransaccionCajasFiltradas = new();

            Snackbar.Add("No se encontró una caja cerrada para la fecha seleccionada.", Severity.Warning);
        }
    }

    private async Task DoSearch((DateTime? from, DateTime? to) args)
    {
        _busy = true;

        try
        {
            if (_idEmpresa <= 0 || _idNegocio <= 0)
            {
                Snackbar.Add("No se pudo obtener la empresa o sucursal del usuario.", Severity.Error);
                return;
            }

            var fecha = args.from ?? DateTime.Now;

            await CargarCajaPorFechaAsync(fecha);

            DateFrom = fecha;
            DateTo = args.to;
        }
        finally
        {
            _busy = false;
        }
    }

    static bool TryParseFecha(string input, out DateTime fecha)
    {
        var formatos = new[]
        {
        "dd/MM/yyyy HH:mm",
        "dd/MM/yyyy",
        "d/M/yyyy HH:mm",
        "d/M/yyyy"
    };

        var esAR = new CultureInfo("es-AR");

        return DateTime.TryParseExact(input, formatos, esAR, DateTimeStyles.None, out fecha)
            || DateTime.TryParse(input, esAR, DateTimeStyles.AllowWhiteSpaces, out fecha)
            || DateTime.TryParse(input, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out fecha);
    }

    private Task DoClearSearch()
    {
        DateFrom = null;
        DateTo = null;

        CajaPorFechaElegida = null;

        _TransaccionCajas = new();
        _TransaccionCajasFiltradas = new();
        Transacciones = new();
        DetallesCajaElegida = new();

        return Task.CompletedTask;
    }


    private Task DoFilter((string? col, string? text) f)
    {
        var col = f.col?.Trim();
        var text = f.text?.Trim();

        if (string.IsNullOrWhiteSpace(col) || string.IsNullOrWhiteSpace(text))
        {
            _TransaccionCajasFiltradas = new List<TransaccionCajaEmpresa>(_TransaccionCajas);
            return Task.CompletedTask;
        }

        var key = col.ToLowerInvariant();

        static bool TryParseDecimalFlexible(string input, out decimal value)
        {
            var esAR = new CultureInfo("es-AR");

            return decimal.TryParse(input, NumberStyles.Number | NumberStyles.AllowCurrencySymbol, esAR, out value)
                || decimal.TryParse(input, NumberStyles.Number | NumberStyles.AllowCurrencySymbol, CultureInfo.InvariantCulture, out value);
        }

        static bool TryParseFecha(string input, out DateTime fecha)
        {
            var formatos = new[]
            {
            "dd/MM/yyyy HH:mm",
            "dd/MM/yyyy",
            "d/M/yyyy HH:mm",
            "d/M/yyyy"
        };

            var esAR = new CultureInfo("es-AR");

            return DateTime.TryParseExact(input, formatos, esAR, DateTimeStyles.None, out fecha)
                || DateTime.TryParse(input, esAR, DateTimeStyles.AllowWhiteSpaces, out fecha)
                || DateTime.TryParse(input, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out fecha);
        }

        _TransaccionCajasFiltradas = key switch
        {
            "tipo" or "tipo movimiento" or "tipo documento" =>
                _TransaccionCajas.FindAll(c =>
                    (c.TipoTransaccion ?? "").Contains(text, StringComparison.OrdinalIgnoreCase)),

            "movimiento" =>
                TryParseFecha(text, out var fechaBuscada)
                    ? _TransaccionCajas.FindAll(c =>
                        c.FechaTransaccion.Date == fechaBuscada.Date)
                    : _TransaccionCajas.FindAll(c =>
                        c.FechaTransaccion
                            .ToString("dd/MM/yyyy HH:mm")
                            .Contains(text, StringComparison.OrdinalIgnoreCase)),

            "vendedor" or "usuario transaccion" =>
                _TransaccionCajas.FindAll(c =>
                    (c.UsuarioTransaccion ?? "").Contains(text, StringComparison.OrdinalIgnoreCase)),

            "detalle" or "docasociado" =>
                _TransaccionCajas.FindAll(c =>
                    (c.Detalle ?? "").Contains(text, StringComparison.OrdinalIgnoreCase)),

            "forma de pago" or "forma pago" =>
                _TransaccionCajas.FindAll(c =>
                    (c.DescripcionFormaPago ?? "").Contains(text, StringComparison.OrdinalIgnoreCase)),

            "monto" or "total" or "monto total" =>
                TryParseDecimalFlexible(text, out var montoBuscado)
                    ? _TransaccionCajas.FindAll(c => Math.Abs(c.Monto - montoBuscado) < 0.005m)
                    : _TransaccionCajas.FindAll(c =>
                        c.Monto.ToString("C", new CultureInfo("es-AR"))
                            .Contains(text, StringComparison.OrdinalIgnoreCase)
                        || c.Monto.ToString("#,0.##", new CultureInfo("es-AR"))
                            .Contains(text, StringComparison.OrdinalIgnoreCase)),

            _ => new List<TransaccionCajaEmpresa>(_TransaccionCajas)
        };

        return Task.CompletedTask;
    }


    private Task DoClearFilter()
    {
        _TransaccionCajasFiltradas = new List<TransaccionCajaEmpresa>(_TransaccionCajas);
        return Task.CompletedTask;
    }




    private async Task DoExport()
    {
        var esAR = new CultureInfo("es-AR");

        string fechaPart = DateFrom?.ToString("yyyyMMdd") ?? "sin_fecha";
        var fileName = $"Detalle Caja Cerrada {fechaPart}.xlsx";

        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("DetalleCaja");

        int r = 1, c = 1;

        ws.Cell(r, c++).Value = "Id Transacción";
        ws.Cell(r, c++).Value = "Fecha Movimiento";
        ws.Cell(r, c++).Value = "Tipo Transacción";
        ws.Cell(r, c++).Value = "Tipo Operación";
        ws.Cell(r, c++).Value = "Monto";
        ws.Cell(r, c++).Value = "Forma de Pago";
        ws.Cell(r, c++).Value = "Detalle";
        ws.Cell(r, c++).Value = "Usuario";

        ws.Range(1, 1, 1, 8).Style.Font.SetBold();
        ws.Range(1, 1, 1, 8).Style.Fill.SetBackgroundColor(
            XLColor.FromTheme(XLThemeColor.Accent1, 0.7)
        );

        r = 2;

        foreach (var x in _TransaccionCajasFiltradas)
        {
            c = 1;

            ws.Cell(r, c++).Value = x.IdTransaccion;
            ws.Cell(r, c++).Value = x.FechaTransaccion;
            ws.Cell(r, c++).Value = x.TipoTransaccion ?? "";
            ws.Cell(r, c++).Value = x.TipoOperacion ?? "";
            ws.Cell(r, c++).Value = x.Monto;
            ws.Cell(r, c++).Value = x.DescripcionFormaPago ?? "";
            ws.Cell(r, c++).Value = x.Detalle ?? "";
            ws.Cell(r, c++).Value = x.UsuarioTransaccion ?? "";

            r++;
        }

        ws.Column(2).Style.DateFormat.Format = "dd/MM/yyyy HH:mm";
        ws.Column(5).Style.NumberFormat.Format = "$ #.##0,00";

        ws.Columns().AdjustToContents();

        if (ws.RangeUsed() is not null)
            ws.RangeUsed().SetAutoFilter();

        using var ms = new MemoryStream();
        wb.SaveAs(ms);

        var base64 = Convert.ToBase64String(ms.ToArray());

        await JS.InvokeVoidAsync(
            "downloadFileFromBytes",
            fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64
        );
    }
}

