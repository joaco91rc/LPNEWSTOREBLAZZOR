@page "/cajadiaria"
@using ClosedXML.Excel
@using MudBlazor
@using Services
@using Entities
@using System.Text
@using System.Security.Claims

@inject CajaRegistradoraEmpresaService CajaRegistradoraEmpresaService
@inject CajaRegistradoraEmpresaDetalleService CajaRegistradoraDetalleService
@inject TransaccionCajaEmpresaService TransaccionCajaEmpresaService
@inject FormaPagoService FormaPagoService
@inject ConceptoService ConceptoService
@inject VendedorService VendedorService
@inject RolService rolService
@inject CajaService CajaService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<AbmLayout TEntity="TransaccionCajaEmpresa"
           FormContent="@FormTransaccion"
           GridContent="@GridTransacciones"
           OnSearchChanged="HandleSearch"
           OnExport="ExportarTransaccionesXlsx"
           SearchPlaceholder="Buscar movimiento de caja…" />

@code {
    [CascadingParameter(Name = "GridSearch")] public string GridSearch { get; set; } = string.Empty;

    List<TransaccionCajaEmpresa> Transacciones = new();
    TransaccionCajaEmpresa TransaccionActual = new();

    CajaRegistradoraEmpresa? CajaActual = null;
    List<CajaRegistradoraEmpresaDetalle> DetallesCajaActual = new();

    private List<FormaPago> _formasPago = new();
    private List<Concepto> _conceptos = new();
    private List<Vendedor> _vendedores = new();
    private List<Caja> _cajas = new();
    private List<Rol> listaRoles = new();

    private MudForm? formTransaccion;
    private bool esEdicion = false;
    private string rolUsuarioActual = string.Empty;

    private IEnumerable<TransaccionCajaEmpresa> TransaccionesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(GridSearch))
                return Transacciones;

            var term = GridSearch.Trim();

            bool Has(string? s) => s?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

            return Transacciones.Where(p =>
                Has(p.Detalle) ||
                Has(p.TipoTransaccion) ||
                Has(p.TipoOperacion) ||
                Has(p.DescripcionCaja) ||
                Has(p.DescripcionFormaPago) ||
                Has(p.UsuarioTransaccion)
            );
        }
    }

    private string SimboloMonedaSeleccionada
    {
        get
        {
            var caja = _cajas.FirstOrDefault(x => x.IdCaja == TransaccionActual.IdCaja);
            if (caja is null)
                return "$";

            return caja.IdMoneda == 2 ? "U$S" : "$";
        }
    }

    private Task OnFormaPagoChanged(int? idFormaPago)
    {
        TransaccionActual.IdFormaPago = idFormaPago;

        if (idFormaPago is null or 0)
        {
            TransaccionActual.IdCaja = 0;
            return Task.CompletedTask;
        }

        var formaPago = _formasPago
            .FirstOrDefault(x => x.IdFormaPago == idFormaPago.Value);

        if (formaPago is null)
        {
            TransaccionActual.IdCaja = 0;
            return Task.CompletedTask;
        }

        TransaccionActual.IdCaja = formaPago.IdCajaAsociada;

        return Task.CompletedTask;
    }

    private Task OnConceptoChanged(int? idConcepto)
    {
        TransaccionActual.IdConcepto = idConcepto;

        if (idConcepto is null or 0)
        {
            TransaccionActual.TipoTransaccion = string.Empty;
            return Task.CompletedTask;
        }

        var concepto = _conceptos
            .FirstOrDefault(x => x.IdConcepto == idConcepto.Value);

        if (concepto is null)
        {
            TransaccionActual.TipoTransaccion = string.Empty;
            return Task.CompletedTask;
        }

        TransaccionActual.TipoTransaccion = concepto.Tipo;

        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            rolUsuarioActual = user.Claims
                .FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? string.Empty;
        }

        _formasPago = await FormaPagoService.ListarFormasDePago();
        _conceptos = await ConceptoService.ListarAsync();
        _vendedores = await VendedorService.ListarVendedores();
        _cajas = await CajaService.ListarCajas(true);
        listaRoles = await rolService.Listar();

        await CargarCajaActualAsync();
    }

    private async Task CargarCajaActualAsync()
    {
        CajaActual = await CajaRegistradoraEmpresaService.ObtenerCajaActual();

        if (CajaActual is not null)
        {
            Transacciones = await TransaccionCajaEmpresaService
                .ListarPorCajaRegistradoraAsync(CajaActual.IdCajaRegistradora);

            DetallesCajaActual = await CajaRegistradoraDetalleService
                .Listar(CajaActual.IdCajaRegistradora);
        }
        else
        {
            Transacciones = new();
            DetallesCajaActual = new();
        }
    }

    private Task HandleSearch(string value)
    {
        GridSearch = value;
        return Task.CompletedTask;
    }

    private async Task ExportarTransaccionesXlsx()
    {
        var fileName = $"CajaDiaria_{DateTime.Now:yyyyMMddHHmmss}.xlsx";

        var rows = TransaccionesFiltradas.Select(p => new
        {
            Fecha = p.FechaTransaccion.ToString("dd/MM/yyyy HH:mm"),
            Movimiento = p.TipoTransaccion,
            Operacion = p.TipoOperacion,
            Caja = p.DescripcionCaja,
            FormaPago = p.DescripcionFormaPago,
            Monto = p.Monto,
            Detalle = p.Detalle,
            Vendedor = p.UsuarioTransaccion
        }).ToList();

        await Task.Yield();

        byte[] bytes = await Task.Run(() =>
        {
            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("CajaDiaria");

            int r = 1, c = 1;
            ws.Cell(r, c++).Value = "Fecha";
            ws.Cell(r, c++).Value = "Movimiento";
            ws.Cell(r, c++).Value = "Operación";
            ws.Cell(r, c++).Value = "Caja";
            ws.Cell(r, c++).Value = "Forma de Pago";
            ws.Cell(r, c++).Value = "Monto";
            ws.Cell(r, c++).Value = "Detalle";
            ws.Cell(r, c++).Value = "Vendedor";

            int lastCol = c - 1;
            ws.Range(1, 1, 1, lastCol).Style.Font.SetBold();
            ws.Range(1, 1, 1, lastCol).Style.Fill
                .SetBackgroundColor(XLColor.FromTheme(XLThemeColor.Accent1, 0.7));
            ws.SheetView.FreezeRows(1);

            r = 2;
            foreach (var p in rows)
            {
                c = 1;
                ws.Cell(r, c++).Value = p.Fecha;
                ws.Cell(r, c++).Value = p.Movimiento;
                ws.Cell(r, c++).Value = p.Operacion;
                ws.Cell(r, c++).Value = p.Caja;
                ws.Cell(r, c++).Value = p.FormaPago;
                ws.Cell(r, c++).Value = p.Monto;
                ws.Cell(r, c++).Value = p.Detalle;
                ws.Cell(r, c++).Value = p.Vendedor;
                r++;
            }

            var used = ws.RangeUsed();
            if (used is not null)
            {
                used.SetAutoFilter();
                ws.Columns(1, lastCol).AdjustToContents(1, rows.Count + 1);
            }

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            return ms.ToArray();
        });

        using var msOut = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(msOut);
        await JS.InvokeVoidAsync("downloadFromStream",
            fileName,
            streamRef,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task Registrar()
    {
        if (formTransaccion is null)
            return;

        if (CajaActual is null)
        {
            Snackbar.Add("No hay una caja abierta para registrar movimientos.", Severity.Warning);
            return;
        }

        await formTransaccion.Validate();

        if (!formTransaccion.IsValid)
        {
            Snackbar.Add("Por favor completá todos los campos requeridos.", Severity.Error);
            return;
        }

        if (esEdicion)
        {
            Snackbar.Add("La edición de movimientos todavía no está implementada para el nuevo modelo.", Severity.Warning);
            return;
        }

        TransaccionActual.IdCajaRegistradora = CajaActual.IdCajaRegistradora;
        TransaccionActual.TipoOperacion = "MANUAL";

        var (idGenerado, mensaje) = await TransaccionCajaEmpresaService.RegistrarMovimientoCompletoAsync(TransaccionActual);

        if (idGenerado > 0)
        {
            Snackbar.Add(mensaje, Severity.Success);

            TransaccionActual = new TransaccionCajaEmpresa();

            await CargarCajaActualAsync();
            await formTransaccion.ResetAsync();
        }
        else
        {
            Snackbar.Add(mensaje, Severity.Error);
        }
    }

    private async Task CerrarCajaAsync()
    {
        if (CajaActual is null)
        {
            Snackbar.Add("No hay ninguna caja para cerrar.", Severity.Warning);
            return;
        }

        bool? confirmado = await DialogService.ShowMessageBox(
            title: "Cerrar Caja",
            markupMessage: (MarkupString)"<b>¿Está seguro que desea cerrar la caja actual?</b>",
            yesText: "Sí",
            cancelText: "Cancelar",
            options: new DialogOptions() { MaxWidth = MaxWidth.Small });

        if (confirmado != true)
            return;

        var (resultado, mensaje) = await CajaRegistradoraEmpresaService.CerrarCaja();

        if (resultado)
        {
            Snackbar.Add("Caja cerrada correctamente.", Severity.Success);

            CajaActual = null;
            Transacciones = new();
            DetallesCajaActual = new();

            Navigation.NavigateTo("/");
        }
        else
        {
            Snackbar.Add(mensaje, Severity.Error);
        }
    }

    private void CancelarEdicion()
    {
        TransaccionActual = new TransaccionCajaEmpresa();
        esEdicion = false;
    }

    private string FormatearMonto(TransaccionCajaEmpresa t)
    {
        var caja = _cajas.FirstOrDefault(x => x.IdCaja == t.IdCaja);
        var simbolo = caja?.IdMoneda == 2 ? "U$S" : "$";
        return $"{simbolo} {t.Monto:N2}";
    }

    RenderFragment FormTransaccion => @<div style="padding: 16px; padding-top:16px">
    <MudForm @ref="formTransaccion" OnValidSubmit="Registrar">
        <MudStack Spacing="2">

            <MudSelect T="int?"
                       Label="Concepto"
                       Value="TransaccionActual.IdConcepto"
                       ValueChanged="OnConceptoChanged"
                       Required="true"
                       Dense="true"
                       FullWidth="true">
                @foreach (var c in _conceptos)
                                {
                <MudSelectItem T="int?" Value="@c.IdConcepto">@c.Descripcion</MudSelectItem>
                                }
            </MudSelect>

            <MudSelect T="string"
                       Label="Movimiento"
                       @bind-Value="TransaccionActual.TipoTransaccion"
                       Required="true"
                       Dense="true"
                       FullWidth="true"
                       Disabled="true">
                <MudSelectItem T="string" Value="@("INGRESO")">Ingreso</MudSelectItem>
                <MudSelectItem T="string" Value="@("EGRESO")">Egreso</MudSelectItem>
            </MudSelect>

            <MudSelect T="int?"
                       Label="Forma de Pago"
                       Value="TransaccionActual.IdFormaPago"
                       ValueChanged="OnFormaPagoChanged"
                       Dense="true"
                       Required="true"
                       FullWidth="true">
                @foreach (var fp in _formasPago)
                                {
                <MudSelectItem T="int?" Value="@fp.IdFormaPago">@fp.Descripcion</MudSelectItem>
                                }
            </MudSelect>

            <MudSelect T="int"
                       Label="Caja Asociada"
                       @bind-Value="TransaccionActual.IdCaja"
                       Dense="true"
                       Required="true"
                       FullWidth="true"
                       Disabled="true">
                @foreach (var caja in _cajas)
                                {
                <MudSelectItem T="int" Value="@caja.IdCaja">
                    @caja.Descripcion (@(caja.IdMoneda == 1 ? "Principal" : "USD"))
                </MudSelectItem>
                                }
            </MudSelect>

            <MudNumericField T="decimal"
                             Label="Monto"
                             @bind-Value="TransaccionActual.Monto"
                             Required="true"
                             Dense="true"
                             FullWidth="true"
                             Adornment="Adornment.Start"
                             AdornmentText="@SimboloMonedaSeleccionada"
                             Format="N2" />

            <MudTextField Label="Detalle" Required="true" @bind-Value="TransaccionActual.Detalle" />

            <MudSelect T="string"
                       Label="Vendedor"
                       @bind-Value="TransaccionActual.UsuarioTransaccion"
                       Dense="true"
                       Required="true"
                       FullWidth="true">
                @foreach (var v in _vendedores)
                                {
                <MudSelectItem T="string" Value="@($"{v.Nombre} {v.Apellido}")">@v.Nombre @v.Apellido</MudSelectItem>
                                }
            </MudSelect>

            <MudStack Direction="Row" Spacing="2">
                <MudButton OnClick="Registrar" Variant="Variant.Filled" Color="Color.Primary">
                    Guardar
                </MudButton>
            </MudStack>
        </MudStack>
    </MudForm>
</div>;

    RenderFragment GridTransacciones => @<div style="padding: 16px; padding-top:16px">

        <MudPaper Class="mt-3 p-3" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Saldos de Caja</MudText>

            <MudTable Items="DetallesCajaActual" Dense="true" Hover="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>Caja</MudTh>
                    <MudTh>Moneda</MudTh>
                    <MudTh>Saldo Inicial</MudTh>
                    <MudTh>Saldo Actual</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.DescripcionCaja</MudTd>
                    <MudTd>@context.MonedaDescripcion</MudTd>
                    <MudTd>@context.SaldoInicial.ToString("N2")</MudTd>
                    <MudTd>@context.SaldoActual.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudStack Class="mt-3" AlignItems="AlignItems.End">
                <MudButton Color="Color.Error"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.CheckBox"
                           OnClick="CerrarCajaAsync">
                    Cerrar Caja
                </MudButton>
            </MudStack>
        </MudPaper>

        <MudTable Items="TransaccionesFiltradas"
                  Dense="true"
                  Hover="true"
                  Bordered="true"
                  Striped="true"
                  Sortable="true"
                  Breakpoint="Breakpoint.Sm"
                  RowsPerPageOptions="new int[]{ 5, 10, 20,30,40,50 }"
                  PagerAlwaysVisible="true"
                  Elevation="1"
                  Class="mt-2">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="TransaccionCajaEmpresa" SortBy="@(c => c.FechaTransaccion)">Fecha</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="TransaccionCajaEmpresa" SortBy="@(c => c.TipoTransaccion)">Movimiento</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="TransaccionCajaEmpresa" SortBy="@(c => c.TipoOperacion)">Operación</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="TransaccionCajaEmpresa" SortBy="@(c => c.DescripcionCaja)">Caja</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="TransaccionCajaEmpresa" SortBy="@(c => c.DescripcionFormaPago)">Forma de Pago</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="TransaccionCajaEmpresa" SortBy="@(c => c.Monto)">Monto</MudTableSortLabel></MudTh>
                <MudTh>Detalle</MudTh>
                <MudTh>Vendedor</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>@context.FechaTransaccion.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@context.TipoTransaccion</MudTd>
                <MudTd>@context.TipoOperacion</MudTd>
                <MudTd>@context.DescripcionCaja</MudTd>
                <MudTd>@context.DescripcionFormaPago</MudTd>
                <MudTd>@FormatearMonto(context)</MudTd>
                <MudTd>@context.Detalle</MudTd>
                <MudTd>@context.UsuarioTransaccion</MudTd>
            </RowTemplate>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 20, 50, 100, 200 }"
                               RowsPerPageString="Registros por página" />
            </PagerContent>
        </MudTable>
    </div>;
}