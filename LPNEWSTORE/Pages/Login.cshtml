@page
@using Services
@model LPNEWSTORE.Pages.LoginModel
@{
    Layout = "/Pages/EmptyLayout.cshtml";
}

@section Styles {
    <link href="css/Login.css" rel="stylesheet" />
}

<div class="hero">
    <div class="main-box">
        <div class="form-box">
            <div class="sp sp-t"></div>
            <div class="sp sp-r"></div>
            <div class="sp sp-b"></div>
            <div class="sp sp-l"></div>

            <div class="logo-container" style="display:flex; justify-content:center; align-items:center; margin-bottom:50px;">
                <img src="~/images/logoRoyalTech.png" alt="Logo" class="logo-img" height="170" width="170" />
            </div>

            <div class="input-group">

                @if (!Model.UsuarioValidado)
                {
                    <form method="post" asp-page-handler="ValidarUsuario">
                        @Html.AntiForgeryToken()

                        <input asp-for="Input.Username"
                               class="input-field"
                               placeholder="Usuario" />

                        <input asp-for="Input.Password"
                               type="password"
                               class="input-field"
                               placeholder="Contraseña" />

                        <button type="submit" class="submit-btn">Iniciar sesión</button>
                    </form>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger mt-2">@Model.ErrorMessage</div>
                }

                @if (Model.UsuarioValidado)
                {
                    <div class="welcome-box">
                        <div class="empresa-bienvenida">
                            Bienvenido a la empresa <span>@Model.NombreEmpresa</span>
                        </div>

                        <div class="usuario-info">
                            <div><strong>Usuario:</strong> @Model.NombreUsuario</div>
                            @if (!string.IsNullOrWhiteSpace(Model.NombreRol))
                            {
                                <div><strong>Rol:</strong> @Model.NombreRol</div>
                            }
                        </div>
                    </div>

                    <form method="post" asp-page-handler="EntrarSistema">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Input.Username" />
                        <input type="hidden" asp-for="Input.Password" />
                        <input type="hidden" asp-for="Input.IdEmpresa" />

                        <div class="sucursal-row">
                            <label class="sucursal-label" asp-for="Input.Sucursal">Sucursal:</label>
                            <select asp-for="Input.Sucursal" class="input-field sucursal-select" asp-items="Model.Sucursales">
                                <option value="">Seleccione Sucursal</option>
                            </select>
                        </div>

                        <button type="submit" class="submit-btn btn-entrar">
                            Entrar al sistema
                        </button>
                    </form>
                }

            </div>
        </div>
    </div>
</div>